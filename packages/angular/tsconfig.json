{
  "compilerOptions": {
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "importHelpers": true,
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "target": "es2015",
    "module": "es2022",
    "moduleResolution": "bundler",
    "paths": {
      "@ionic/angular/common": ["./src/common/index.ts"]
    },
    "plugins": [
      {
        "name": "typescript-eslint-language-service"
      }
    ]
  },
  "angularCompilerOptions": {
    "annotateForClosureCompiler": true,
    "compilationMode": "partial"
  },
  "files": ["src/standalone/index.ts", "src/lazy/index.ts"]
}
