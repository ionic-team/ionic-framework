{
  "name": "@ionic/migrate",
  "version": "1.0.0",
  "description": "Migration tool to automate and report on breaking changes across Ionic Framework major versions.",
  "keywords": [
    "ionic",
    "framework",
    "migrate",
    "migration",
    "codemod",
    "upgrade",
    "angular",
    "react",
    "vue",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionic-team/ionic-framework.git",
    "directory": "packages/migrate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ionic-migrate": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test.watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "ts-morph": "^25.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
