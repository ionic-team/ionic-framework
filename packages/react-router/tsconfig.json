{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "declarationDir": "dist/types",
    "inlineSources": true,
    "sourceMap": true,
    "jsx": "react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/__tests__/**"],
  "compileOnSave": false,
  "buildOnSave": false
}
