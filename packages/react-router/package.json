{
  "name": "@ionic/react-router",
  "version": "9.0.6",
  "description": "React Router wrapper for @ionic/react",
  "keywords": [
    "ionic",
    "framework",
    "react",
    "mobile",
    "app",
    "hybrid",
    "webapp",
    "cordova",
    "progressive web app",
    "pwa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionic-team/ionic-framework.git"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "build.watch": "npm run compile -- --watch",
    "clean": "rimraf dist",
    "compile": "rollup -c",
    "eslint": "eslint src type-tests",
    "prettier": "prettier \"./{src,type-tests}/**/*.{html,ts,tsx,js,jsx}\"",
    "lint": "npm run eslint && npm run prettier -- --write --cache",
    "lint.fix": "npm run eslint -- --fix && npm run prettier -- --write --cache",
    "typecheck": "npm run typecheck.rr6 && npm run typecheck.rr7",
    "typecheck.rr6": "tsc --noEmit",
    "typecheck.rr7": "tsc --noEmit -p tsconfig.rr7.json",
    "sync": "sh ./scripts/sync.sh"
  },
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@ionic/core": "^9.0.6",
    "@ionic/react": "^9.0.6",
    "tslib": "*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-router": ">=6.4.0 <7 || >=7.15.0 <8",
    "react-router-dom": ">=6.4.0 <7 || >=7.15.0 <8"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.0.0",
    "@ionic/eslint-config": "^0.3.0",
    "@ionic/prettier-config": "^2.0.0",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^2.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0",
    "react-router-dom-v7": "npm:react-router-dom@^7.18.4",
    "rimraf": "^3.0.2",
    "rollup": "^4.2.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "@ionic/eslint-config": {
      "@typescript-eslint/parser": "$@typescript-eslint/parser",
      "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin",
      "eslint-plugin-import": "$eslint-plugin-import"
    }
  },
  "prettier": "@ionic/prettier-config"
}
