{
  "name": "@ionic/vue-router",
  "version": "9.0.2",
  "description": "Vue Router integration for @ionic/vue",
  "scripts": {
    "eslint": "eslint src",
    "prettier": "prettier \"./src/**/*.{html,ts,tsx,js,jsx}\"",
    "lint": "npm run eslint && npm run prettier -- --write --cache",
    "lint.fix": "npm run eslint -- --fix && npm run prettier -- --write --cache",
    "typecheck": "tsc --noEmit",
    "bundle": "rollup --config rollup.config.mjs",
    "build": "npm run clean && npm run bundle",
    "build.watch": "npm run bundle -- --watch",
    "clean": "rimraf dist",
    "sync": "sh ./scripts/sync.sh"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionic-team/ionic-framework.git"
  },
  "keywords": [
    "ionic",
    "framework",
    "vue",
    "mobile",
    "app",
    "hybrid",
    "webapp",
    "cordova",
    "progressive",
    "web",
    "app",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ionic-team/ionic-framework/issues"
  },
  "homepage": "https://github.com/ionic-team/ionic-framework#readme",
  "dependencies": {
    "@ionic/vue": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.0.0",
    "@ionic/eslint-config": "^0.3.0",
    "@ionic/prettier-config": "^2.0.0",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^2.8.3",
    "rimraf": "^3.0.2",
    "rollup": "^4.2.0",
    "typescript": "^6.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "overrides": {
    "@ionic/eslint-config": {
      "@typescript-eslint/parser": "$@typescript-eslint/parser",
      "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin",
      "eslint-plugin-import": "$eslint-plugin-import"
    },
    "postcss": "8.5.23"
  }
}
