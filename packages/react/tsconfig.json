{
  "extends": "../../core/tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "outDir": "dist",
    "declarationDir": "dist/types",
    /*
     * rootDir is set to satisfy @rollup/plugin-typescript (TS5011) so the
     * output file layout is predictable. Setting rootDir restricts the program
     * to files under it, which stops @types from being auto-included, so the
     * ambient type packages must be listed explicitly. jest and jest-dom are
     * needed because the test files are type-checked as part of the build.
     */
    "rootDir": "src",
    "types": ["node", "jest", "@testing-library/jest-dom"],
    /*
     * @types/node is pinned to v14 here, which predates AbortSignal.any() in
     * lib.dom.d.ts, so the two global declarations of AbortSignal conflict
     * (TS2403). skipLibCheck keeps tsc from checking declaration files we do
     * not own; errors in this package's own source are still reported.
     */
    "skipLibCheck": true,
    "inlineSources": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "target": "es2022"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compileOnSave": false,
  "buildOnSave": false
}
