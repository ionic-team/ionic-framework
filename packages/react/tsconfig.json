{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "esModuleInterop": true,
    "outDir": "dist",
    "declarationDir": "dist/types",
    "rootDir": "src",
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "inlineSources": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "target": "es2022"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compileOnSave": false,
  "buildOnSave": false
}
