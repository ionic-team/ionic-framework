{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "noImplicitReturns": false,
    "outDir": "dist",
    "declarationDir": "dist/types",
    "sourceMap": true,
    "jsx": "react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["./__tests__/**", "node_modules", "setupTests.ts"],
  "compileOnSave": false,
  "buildOnSave": false
}
