# Internal values for scripts/release-patch.sh.
#
# Copy this file to ~/.config/ionic-release.env (or point IONIC_RELEASE_CONFIG
# at another path) and fill in the real values from the Releases page on
# Confluence. Never commit the filled-in copy.
#
# The script reads these keys and ignores everything else. It refuses to
# run if the file is missing or either value is still a placeholder.

# Jira Cloud site, no trailing slash
JIRA_BASE_URL=https://your-site.atlassian.net

# Jira project key the releases are created in
JIRA_PROJECT=ABC
