{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "assumeChangesOnlyAffectDirectDependencies": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "types": ["node", "vitest/globals", "@stencil/vitest"],
    "paths": {
      "@utils/*": ["./src/utils/*"],
      "@utils/test": ["./src/utils/test/utils"],
      "@global/*": ["./src/global/*"]
    }
  },
  "include": [
    "src",
    "vitest.setup.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
